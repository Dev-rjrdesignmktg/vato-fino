{%- comment -%}
  VATOFINO Hero
  Rendimiento:
  - CSS crítico inline (sin solicitud que bloquee el renderizado).
  - Solo el primer slide se descarga con prioridad alta; el resto queda en
    display:none hasta que la página termina de cargar (ver custom-hero.js).
  - Imágenes dirigidas por dispositivo (<picture> + recortes en el CDN de
    Shopify centrados en el punto focal, ver snippets/vf-hero-crop.liquid):
      · Móvil vertical  (≤768px, portrait) → 9:16
      · Tablet vertical (≥769px, portrait) → 3:4
      · Desktop / tablet y móvil horizontales → imagen horizontal
    Así cada pantalla descarga solo los píxeles que muestra.
{%- endcomment -%}

{%- liquid
  assign slide_count = section.blocks.size
  assign autoplay_speed = section.settings.autoplay_speed | times: 1000
  assign mobile_widths = '360,540,720,900,1080,1290'
  assign tablet_widths = '768,1024,1280,1536,2048'
  assign desktop_widths = '960,1280,1600,1920,2400,3000'
  assign mobile_media = '(max-width: 768px) and (orientation: portrait)'
  assign tablet_media = '(min-width: 769px) and (orientation: portrait)'
-%}

<style>
  #vf-hero-{{ section.id }}{position:relative;height:calc(100vh - var(--header-group-height,0px));height:calc(100svh - var(--header-group-height,0px));min-height:480px;overflow:hidden;background:#000;color:#fff}
  #vf-hero-{{ section.id }} .vf-hero__slider{height:100%}
  #vf-hero-{{ section.id }} .vf-hero__slide{position:absolute;inset:0;opacity:0;visibility:hidden;transition:opacity .8s ease,visibility 0s linear .8s}
  #vf-hero-{{ section.id }} .vf-hero__slide.is-active{opacity:1;visibility:visible;transition:opacity .8s ease}
  #vf-hero-{{ section.id }}:not(.is-ready) .vf-hero__slide:not(.is-active){display:none}
  #vf-hero-{{ section.id }} .vf-hero__media,#vf-hero-{{ section.id }} .vf-hero__image{display:block;width:100%;height:100%}
  #vf-hero-{{ section.id }} .vf-hero__image{object-fit:cover;object-position:var(--vf-pos-desktop,50% 50%)!important}
  @media (max-width:768px) and (orientation:portrait){#vf-hero-{{ section.id }} .vf-hero__image{object-position:var(--vf-pos-mobile,50% 50%)!important}}
  @media (min-width:769px) and (orientation:portrait){#vf-hero-{{ section.id }} .vf-hero__image{object-position:var(--vf-pos-tablet,50% 50%)!important}}
  #vf-hero-{{ section.id }} .vf-hero__overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.65) 0%,rgba(0,0,0,.3) 40%,rgba(0,0,0,.05) 100%)}
  #vf-hero-{{ section.id }} .vf-hero__content{position:absolute;left:8%;bottom:12%;z-index:10;max-width:900px}
  #vf-hero-{{ section.id }} .vf-hero__title{font-family:'CSClaes-Regular',serif;color:#fff;font-size:clamp(2.5rem,4vw,4.5rem);line-height:1.2;letter-spacing:-.05em;margin:1rem 0;text-transform:none}
  #vf-hero-{{ section.id }} .vf-hero__eyebrow{margin:0;color:#fff;letter-spacing:.2em;font-size:.75rem;line-height:1.5;text-transform:uppercase}
  #vf-hero-{{ section.id }} .vf-hero__text{max-width:40ch;margin:0;color:rgba(255,255,255,.9);line-height:1.8;font-size:1.1rem}
  #vf-hero-{{ section.id }} .vf-hero__button{margin-top:2rem;display:inline-flex;align-items:center;min-height:44px;padding:1rem 2rem;line-height:1.2;border:1px solid rgba(255,255,255,.6);color:#fff;text-decoration:none}
  @media (max-width:768px){
    #vf-hero-{{ section.id }} .vf-hero__text{margin:auto}
    #vf-hero-{{ section.id }} .vf-hero__overlay{background:linear-gradient(0deg,rgba(0,0,0,.75) 0%,rgba(0,0,0,.35) 45%,rgba(0,0,0,.1) 100%)}
    #vf-hero-{{ section.id }} .vf-hero__content{left:0;right:0;padding:0 2rem;text-align:center;bottom:5rem}
  }
</style>
<link rel="stylesheet" href="{{ 'custom-hero.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'custom-hero.css' | asset_url | stylesheet_tag }}</noscript>
<script src="{{ 'custom-hero.js' | asset_url }}" defer></script>

<section
  class="vf-hero"
  id="vf-hero-{{ section.id }}"
  aria-roledescription="carrusel"
  aria-label="{{ section.settings.aria_label | default: 'Colecciones destacadas' | escape }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ autoplay_speed }}"
>
  <div class="vf-hero__slider" id="vf-hero-slider-{{ section.id }}" aria-live="off">
    {%- for block in section.blocks -%}
      {%- liquid
        assign desktop_image = block.settings.image
        assign mobile_image = block.settings.image_mobile | default: desktop_image
        assign tablet_image = block.settings.image_tablet | default: block.settings.image_mobile | default: desktop_image
        assign image_alt = block.settings.image_alt | default: block.settings.title | escape

        if forloop.first
          assign image_loading = 'eager'
          assign image_priority = 'high'
        else
          assign image_loading = 'lazy'
          assign image_priority = 'low'
        endif

        if desktop_image != blank
          assign pos_desktop = desktop_image.presentation.focal_point | default: '50% 50%'
          capture pos_mobile
            render 'vf-hero-crop', image: mobile_image, ratio_w: 9, ratio_h: 16, output: 'position'
          endcapture
          capture pos_tablet
            render 'vf-hero-crop', image: tablet_image, ratio_w: 3, ratio_h: 4, output: 'position'
          endcapture
          assign pos_mobile = pos_mobile | strip
          assign pos_tablet = pos_tablet | strip
          assign img_style = '--vf-pos-desktop:' | append: pos_desktop | append: ';--vf-pos-mobile:' | append: pos_mobile | append: ';--vf-pos-tablet:' | append: pos_tablet | append: ';'
        endif
      -%}

      <div
        class="vf-hero__slide{% if forloop.first %} is-active{% endif %}"
        role="group"
        aria-roledescription="diapositiva"
        aria-label="{{ forloop.index }} de {{ slide_count }}"
        {% unless forloop.first %}aria-hidden="true" inert{% endunless %}
        {{ block.shopify_attributes }}
      >
        {%- if desktop_image != blank -%}
          <picture class="vf-hero__media">
            {%- render 'vf-hero-crop',
              image: mobile_image,
              ratio_w: 9,
              ratio_h: 16,
              widths: mobile_widths,
              media: mobile_media,
              output: 'source'
            -%}
            {%- render 'vf-hero-crop',
              image: tablet_image,
              ratio_w: 3,
              ratio_h: 4,
              widths: tablet_widths,
              media: tablet_media,
              output: 'source'
            -%}
            {{
              desktop_image
              | image_url: width: 3000
              | image_tag:
                class: 'vf-hero__image',
                widths: desktop_widths,
                sizes: '100vw',
                loading: image_loading,
                fetchpriority: image_priority,
                decoding: 'async',
                alt: image_alt,
                style: img_style
            }}
          </picture>
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'vf-hero__image' }}
        {%- endif -%}

        <div class="vf-hero__overlay" aria-hidden="true"></div>

        <div class="vf-hero__content">
          {%- if block.settings.eyebrow != blank -%}
            <p class="vf-hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            {%- if forloop.first -%}
              <h1 class="vf-hero__title">{{ block.settings.title | escape }}</h1>
            {%- else -%}
              <h2 class="vf-hero__title">{{ block.settings.title | escape }}</h2>
            {%- endif -%}
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <p class="vf-hero__text">{{ block.settings.text | escape | newline_to_br }}</p>
          {%- endif -%}

          {%- if block.settings.button_url != blank and block.settings.button_text != blank -%}
            <a href="{{ block.settings.button_url }}" class="vf-hero__button">
              {{- block.settings.button_text | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if slide_count > 1 -%}
    <div class="vf-hero__arrow__container">
      <button
        type="button"
        class="vf-hero__arrow vf-hero__arrow--prev"
        aria-controls="vf-hero-slider-{{ section.id }}"
        aria-label="Diapositiva anterior"
      >
        <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </button>
      <button
        type="button"
        class="vf-hero__arrow vf-hero__arrow--next"
        aria-controls="vf-hero-slider-{{ section.id }}"
        aria-label="Diapositiva siguiente"
      >
        <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    </div>

    <div class="vf-hero__controls">
      {%- if section.settings.autoplay -%}
        <button
          type="button"
          class="vf-hero__toggle"
          aria-label="Pausar carrusel"
          data-label-pause="Pausar carrusel"
          data-label-play="Reproducir carrusel"
        >
          <svg class="vf-hero__icon-pause" aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="5" y="4" width="4" height="16"/><rect x="15" y="4" width="4" height="16"/></svg>
          <svg class="vf-hero__icon-play" aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4l13 8-13 8z"/></svg>
        </button>
      {%- endif -%}

      <div class="vf-hero__pagination">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="vf-hero__dot{% if forloop.first %} is-active{% endif %}"
            aria-controls="vf-hero-slider-{{ section.id }}"
            aria-label="Ir a la diapositiva {{ forloop.index }} de {{ slide_count }}"
            {% if forloop.first %}aria-current="true"{% endif %}
            data-index="{{ forloop.index0 }}"
          ></button>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "VATOFINO Hero",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Etiqueta accesible del carrusel",
      "default": "Colecciones destacadas"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Reproducción automática",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Cambiar slide cada",
      "min": 4,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 7
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Desktop y pantallas horizontales. Recomendado: 3000 × 1688 px (16:9). Define el punto focal para controlar los recortes en móvil y tablet."
        },
        {
          "type": "image_picker",
          "id": "image_tablet",
          "label": "Tablet image",
          "info": "Opcional. Para tablets en vertical. Recomendado: 1536 × 2048 px (3:4). Si se deja vacío se usa la imagen móvil o, en su defecto, la principal, recortada alrededor de su punto focal."
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image",
          "info": "Opcional. Para móviles en vertical. Recomendado: 1290 × 2293 px (9:16). Si se deja vacío se recorta la imagen principal alrededor de su punto focal."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image ALT"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "VATOFINO"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VATOFINO Hero"
    }
  ]
}
{% endschema %}
