{%- liquid
  assign section_color = section.settings.color_scheme | default: 'scheme1'
  assign product_list = section.settings.product_list
  assign show_product_image_only = section.settings.show_product_image_only

  assign desktop_layout = section.settings.desktop_layout
  assign enable_cascade_on_mobile = section.settings.enable_cascade_on_mobile

  assign title = section.settings.title

  if title == blank
    if collection
      assign title = collection.title
    else
      assign title = 'sections.onboarding.collection_title' | t
    endif
  endif

  if enable_cascade_on_mobile
    assign eager_loading_limit = 4
  else
    assign eager_loading_limit = 2
  endif

  assign full_width_item_header = '||__cascade-item:full__||'
  assign item_separator = '||__cascade-item-end__||'

  comment
    Cascade width pattern (same values as snippets/cascade.liquid item_widths)
  endcomment
  if section.settings.use_global_settings
    assign cascade_level = settings.cascade_default_level_of_media_size_variation
    assign cascade_sequence = settings.cascade_default_sequence | default: 1
  else
    assign cascade_level = section.settings.level_of_media_size_variation
    assign cascade_sequence = section.settings.sequence | default: 1
  endif

  case cascade_level
    when 1
      assign cascade_fractions = '1,0.8333,0.8333,1,0.8333' | split: ','
    when 2
      assign cascade_fractions = '1,0.6667,0.8333,1,0.6667' | split: ','
    when 3
      assign cascade_fractions = '1,0.5833,0.8333,0.4167,0.6667' | split: ','
    when 4
      assign cascade_fractions = '0.8333,0.3333,0.75,0.4167,0.5833' | split: ','
  endcase
-%}

<section
  class="relative {% unless section.settings.remove_top_padding %}pt-section{% endunless %} {% unless section.settings.remove_bottom_padding %}pb-section{% endunless %} bg-scheme-background text-scheme-text {% if section.settings.disable_color_transition %}disable-section-color-transition disable-section-color-transition-source{% endif %}"
  data-color-scheme="{{ section_color }}"
>
  <div class="mx-auto max-w-site px-5 lg:px-10">
    {% if section.settings.title != blank %}
      {%- render 'cascade-heading',
        title: section.settings.title,
        overlay_heading: section.settings.overlay_heading,
        mobile_text_scale: section.settings.heading_mobile_text_scale,
        desktop_text_scale: section.settings.heading_desktop_text_scale,
        cta_link: section.settings.overlay_cta_link,
        cta_label: section.settings.overlay_cta_label,
        cta_style: section.settings.overlay_cta_style,
        blend_mode: section.settings.blend_mode,
        blend_mode_color_scheme: section.settings.blend_mode_color_scheme
      -%}
    {% endif %}
    <div class="relative">
      {% liquid
        capture product_items
          assign placeholder_index = 0

          assign half_item_index = 0

          for product in product_list
            assign is_full_width_item = false

            if section.settings.feature_full_width_products
              capture item_header
                cycle full_width_item_header, '', ''
              endcapture
              echo item_header

              if item_header == full_width_item_header
                assign is_full_width_item = true
              endif
            endif

            comment
              Mirror snippets/cascade.liquid width pattern so `sizes` matches the real rendered width
            endcomment
            assign item_fraction = 1
            unless is_full_width_item
              if cascade_level != 0
                assign width_index = half_item_index | plus: cascade_sequence | minus: 1 | modulo: 5
                assign item_fraction = cascade_fractions[width_index]
              endif
              assign half_item_index = half_item_index | plus: 1
            endunless

            capture sizes
              render 'cascade-image-sizes', fraction: item_fraction, desktop_layout: desktop_layout, enable_cascade_on_mobile: enable_cascade_on_mobile, full_width: is_full_width_item
            endcapture

            assign preload = false
            assign loading = 'lazy'

            if section.index == 1 and forloop.first
              assign preload = true
            endif

            comment
              Only the first section is above the fold (the hero fills the viewport),
              so images in later sections must not compete with the LCP image
            endcomment
            if section.index == 1 and forloop.index <= eager_loading_limit
              assign loading = 'eager'
            endif

            echo '<div data-media-item>'
            render 'product-tile', product: product, tag: 'div', show_image_only: show_product_image_only, sizes: sizes, preload: preload, loading: loading, full_width_item_header: full_width_item_header
            echo '</div>'
            echo item_separator
          else
            for i in (1..6)
              if section.settings.feature_full_width_products
                cycle full_width_item_header, '', ''
              endif
              assign placeholder_index = placeholder_index | modulo: 6 | plus: 1
              assign placeholder_name = 'product-' | append: placeholder_index
              echo '<div data-media-item>'
              render 'product-tile-placeholder', placeholder_name: placeholder_name, tag: 'div', show_image_only: show_product_image_only, full_width_item_header: full_width_item_header
              echo '</div>'
              echo item_separator
            endfor
          endfor
        endcapture
      %}
      {% render 'cascade',
        section_id: section.id,
        content_items: product_items,
        alternate_first_block_position: true,
        enable_cascade_on_mobile: enable_cascade_on_mobile,
        desktop_layout: desktop_layout,
        level_of_media_size_variation: section.settings.level_of_media_size_variation,
        sequence: section.settings.sequence,
        alignment_variation: section.settings.alignment_variation,
        spacing: section.settings.spacing,
        first_block_position: section.settings.start_position,
        use_global_settings: section.settings.use_global_settings
      %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cascading product list",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "id": "product_list",
      "type": "product_list",
      "label": "Products"
    },
    {
      "type": "checkbox",
      "id": "show_product_image_only",
      "label": "Show product image only",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "feature_full_width_products",
      "label": "Feature full width products",
      "info": "Enable this setting to showcase a mix of products at half width and full width. [Learn more](https://help.switchthemes.co)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_cascade_on_mobile",
      "label": "Enable cascade layout on mobile",
      "default": true
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "default": "two_columns",
      "options": [
        {
          "value": "single_column",
          "label": "One column"
        },
        {
          "value": "two_columns",
          "label": "Two columns"
        }
      ]
    },
    {
      "type": "header",
      "content": "Cascade effect"
    },
    {
      "type": "paragraph",
      "content": "Adjust variation, sequence and alignment of media sizes to create unique layouts. [Learn more](https://help.switchthemes.co/)"
    },
    {
      "type": "range",
      "id": "level_of_media_size_variation",
      "min": 0,
      "max": 4,
      "step": 1,
      "label": "Level of media size variation",
      "default": 2
    },
    {
      "type": "range",
      "id": "sequence",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Sequence",
      "default": 1
    },
    {
      "type": "range",
      "id": "alignment_variation",
      "min": 1,
      "max": 7,
      "step": 1,
      "label": "Alignment variation",
      "default": 1
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 0.5,
      "max": 2,
      "step": 0.5,
      "label": "Vertical space between items",
      "default": 1.5,
      "unit": "x"
    },
    {
      "type": "select",
      "id": "start_position",
      "label": "Start position",
      "options": [
        {
          "value": "left",
          "label": "Top left"
        },
        {
          "value": "right",
          "label": "Top right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "use_global_settings",
      "label": "Use global settings",
      "default": false,
      "info": "This will override all cascade effect settings above. Set up global settings in [theme settings](/editor?context=theme&category=cascading%20content)."
    },
    {
      "type": "header",
      "content": "Heading overlay"
    },
    {
      "type": "checkbox",
      "id": "overlay_heading",
      "label": "Overlay heading",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_mobile_text_scale",
      "min": -2,
      "max": 4,
      "step": 1,
      "label": "Heading mobile font size scale",
      "default": 2
    },
    {
      "type": "range",
      "id": "heading_desktop_text_scale",
      "min": -2,
      "max": 10,
      "step": 1,
      "label": "Heading desktop font size scale",
      "default": 7
    },
    {
      "type": "url",
      "id": "overlay_cta_link",
      "label": "Call to action link"
    },
    {
      "type": "text",
      "id": "overlay_cta_label",
      "label": "Call to action label"
    },
    {
      "type": "select",
      "id": "overlay_cta_style",
      "label": "Call to action style",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "border-only",
          "label": "Border"
        }
      ],
      "default": "solid"
    },
    {
      "type": "select",
      "id": "blend_mode",
      "label": "Blend mode",
      "info": "Some blend modes work better when the text color is dark, others when it is light",
      "default": "normal",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "difference",
          "label": "Difference"
        },
        {
          "value": "exclusion",
          "label": "Exclusion"
        },
        {
          "value": "overlay",
          "label": "Overlay"
        },
        {
          "value": "soft-light",
          "label": "Soft light"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "blend_mode_color_scheme",
      "label": "Blend mode color scheme",
      "info": "Only used if “Blend mode” is not “Normal”"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme1",
      "label": "Color scheme"
    },
    {
      "type": "checkbox",
      "id": "disable_color_transition",
      "label": "Disable transition",
      "info": "Overrides section color transitions theme setting."
    },
    {
      "type": "header",
      "content": "Spacing",
      "info": "Adjust vertical spacing to visually connect this section to adjacent sections"
    },
    {
      "type": "checkbox",
      "id": "remove_top_padding",
      "label": "Remove top padding",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "remove_bottom_padding",
      "label": "Remove bottom padding",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Cascading product list"
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  }
}
{% endschema %}
