<ul class="{% unless has_two_linklists %} flex flex-wrap {% endunless %} -mx-2 text-theme-basic">
  {% for link in linklist.links %}
    <li class="break-word mx-2">
      <a
        href="{{ link.url }}"
        class="link-underline footer-link"
        {% if link.current %}aria-current="page"{% endif %}
      >
        {{ link.title }}
      </a>
    </li>
  {% endfor %}
</ul>
